<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080808">
  <title>غشيم 🇴🇲</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      color: #fff;
      background:
        linear-gradient(rgba(0,0,0,.72), rgba(0,0,0,.88)),
        url("pacino-background.jpg") center/cover fixed;
      overflow-x: hidden;
    }
    .overlay {
      min-height: 100vh;
      padding: 25px 15px 40px;
      backdrop-filter: blur(3px);
    }
    .container {
      width: 100%;
      max-width: 900px;
      margin: auto;
    }
    header {
      text-align: center;
      margin: 25px 0 30px;
    }
    .logo {
      font-size: 42px;
      font-weight: 900;
      letter-spacing: -1px;
      text-shadow: 0 4px 20px rgba(0,0,0,.8);
    }
    .subtitle {
      margin-top: 8px;
      color: #bbb;
      font-size: 14px;
    }
    .language {
      position: fixed;
      top: 15px;
      left: 15px;
      z-index: 20;
    }
    button {
      border: 0;
      cursor: pointer;
      color: #fff;
      font-weight: 700;
      transition: .2s;
    }
    .lang-btn {
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.15);
      padding: 9px 14px;
      border-radius: 12px;
      backdrop-filter: blur(10px);
    }
    .lang-btn:hover {
      background: rgba(255,255,255,.18);
    }
    .access-box {
      max-width: 480px;
      margin: 0 auto 30px;
      padding: 22px;
      border-radius: 22px;
      background: rgba(15,15,15,.75);
      border: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 15px 50px rgba(0,0,0,.35);
      backdrop-filter: blur(15px);
    }
    .access-box h2 {
      text-align: center;
      margin-bottom: 15px;
      font-size: 20px;
    }
    input {
      width: 100%;
      padding: 14px;
      border-radius: 13px;
      border: 1px solid rgba(255,255,255,.12);
      outline: none;
      background: rgba(255,255,255,.07);
      color: #fff;
      font-size: 15px;
      margin-bottom: 12px;
    }
    input::placeholder {
      color: #888;
    }
    .primary {
      width: 100%;
      padding: 14px;
      border-radius: 13px;
      background: #fff;
      color: #000;
      font-size: 15px;
    }
    .primary:hover {
      transform: translateY(-1px);
      opacity: .9;
    }
    .message {
      min-height: 20px;
      margin-top: 10px;
      text-align: center;
      font-size: 13px;
      color: #aaa;
    }
    #dashboard {
      display: none;
    }
    .welcome {
      text-align: center;
      margin-bottom: 25px;
    }
    .welcome h2 {
      font-size: 27px;
      margin-bottom: 7px;
    }
    .welcome p {
      color: #aaa;
      font-size: 14px;
    }
    .cars {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .car-card {
      padding: 24px;
      min-height: 230px;
      border-radius: 24px;
      background: rgba(15,15,15,.78);
      border: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 15px 50px rgba(0,0,0,.35);
      backdrop-filter: blur(15px);
      text-align: center;
    }
    .car-icon {
      font-size: 45px;
      margin-bottom: 12px;
    }
    .car-card h3 {
      font-size: 22px;
      margin-bottom: 8px;
    }
    .status {
      color: #aaa;
      font-size: 13px;
      margin-bottom: 20px;
    }
    .car-btn {
      width: 100%;
      padding: 13px;
      border-radius: 13px;
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.12);
    }
    .car-btn:hover {
      background: rgba(255,255,255,.18);
    }
    .account {
      margin-top: 20px;
      padding: 20px;
      border-radius: 20px;
      background: rgba(15,15,15,.75);
      border: 1px solid rgba(255,255,255,.1);
    }
    .account h3 {
      margin-bottom: 12px;
    }
    .data {
      color: #aaa;
      line-height: 1.9;
      font-size: 14px;
    }
    .logout {
      display: block;
      margin: 22px auto 0;
      padding: 11px 22px;
      border-radius: 12px;
      background: rgba(255,70,70,.12);
      border: 1px solid rgba(255,70,70,.2);
      color: #fff;
    }
    footer {
      text-align: center;
      margin-top: 35px;
      color: #666;
      font-size: 12px;
    }
    @media (max-width: 650px) {
      .cars {
        grid-template-columns: 1fr;
      }
      .logo {
        font-size: 34px;
      }
      .overlay {
        padding-top: 55px;
      }
    }
  </style>
</head>
<body>
<div class="language">
  <button class="lang-btn" onclick="toggleLanguage()" id="langButton">
    English
  </button>
</div>
<div class="overlay">
  <div class="container">
    <header>
      <div class="logo">غشيم 🇴🇲</div>
      <div class="subtitle" id="subtitle">
        لوحة التحكم
      </div>
    </header>
    <!-- Access -->
    <section class="access-box" id="accessBox">
      <h2 id="accessTitle">دخول الموقع</h2>
      <input
        id="accessCode"
        type="password"
        placeholder="أدخل كود الدخول"
        autocomplete="off"
      >
      <button class="primary" onclick="login()" id="loginButton">
        دخول
      </button>
      <div class="message" id="loginMessage"></div>
    </section>
    <!-- Dashboard -->
    <main id="dashboard">
      <section class="welcome">
        <h2 id="welcomeTitle">غشيم و العالم 😜</h2>
        <p id="welcomeText">
          اختر السيارة التي تريد عرض بياناتها
        </p>
      </section>
      <section class="cars">
        <article class="car-card">
          <div class="car-icon">🚗</div>
          <h3 id="car1Title">Car 1</h3>
          <div class="status" id="car1Status">
            جاهزة للاتصال بالـAPI
          </div>
          <button
            class="car-btn"
            onclick="selectCar(1)"
            id="car1Button">
            عرض البيانات
          </button>
        </article>
        <article class="car-card">
          <div class="car-icon">🚘</div>
          <h3 id="car2Title">Car 2</h3>
          <div class="status" id="car2Status">
            جاهزة للاتصال بالـAPI
          </div>
          <button
            class="car-btn"
            onclick="selectCar(2)"
            id="car2Button">
            عرض البيانات
          </button>
        </article>
      </section>
      <section class="account">
        <h3 id="accountTitle">بيانات الحساب</h3>
        <div class="data" id="accountData">
          لم يتم جلب بيانات الحساب بعد.
        </div>
      </section>
      <button class="logout" onclick="logout()" id="logoutButton">
        تسجيل خروج
      </button>
    </main>
    <footer>
      غشيم 🇴🇲
    </footer>
  </div>
</div>
<script>
  /*
    هذا الملف يعمل على GitHub Pages.
    مهم:
    لا تضع هنا كلمة مرور CPM أو Firebase API Secret.
    عندما نجهز Backend مصرحًا به:
    سيتم الاتصال به من هنا عبر HTTPS.
  */
  const SITE_ACCESS_CODE = "x5v10_111";
  let english = false;
  function login() {
    const input = document.getElementById("accessCode");
    const message = document.getElementById("loginMessage");
    if (input.value === SITE_ACCESS_CODE) {
      document.getElementById("accessBox").style.display = "none";
      document.getElementById("dashboard").style.display = "block";
      message.textContent = "";
      sessionStorage.setItem("site_access", "1");
    } else {
      message.textContent = english
        ? "Incorrect access code."
        : "كود الدخول غير صحيح.";
    }
  }
  function logout() {
    sessionStorage.removeItem("site_access");
    document.getElementById("dashboard").style.display = "none";
    document.getElementById("accessBox").style.display = "block";
    document.getElementById("accessCode").value = "";
    document.getElementById("loginMessage").textContent = "";
  }
  function selectCar(carNumber) {
    const data = document.getElementById("accountData");
    data.innerHTML = english
      ? "Car " + carNumber + " selected. Backend connection is not configured yet."
      : "تم اختيار Car " + carNumber + ". اتصال الـBackend غير مفعّل حاليًا.";
  }
  function toggleLanguage() {
    english = !english;
    document.documentElement.lang = english ? "en" : "ar";
    document.documentElement.dir = english ? "ltr" : "rtl";
    document.getElementById("langButton").textContent =
      english ? "العربية" : "English";
    document.getElementById("subtitle").textContent =
      english ? "Control Panel" : "لوحة التحكم";
    document.getElementById("accessTitle").textContent =
      english ? "Site Login" : "دخول الموقع";
    document.getElementById("accessCode").placeholder =
      english ? "Enter access code" : "أدخل كود الدخول";
    document.getElementById("loginButton").textContent =
      english ? "Login" : "دخول";
    document.getElementById("welcomeTitle").textContent =
      english ? "Ghasheem & The World 😜" : "غشيم و العالم 😜";
    document.getElementById("welcomeText").textContent =
      english
        ? "Choose the car you want to view"
        : "اختر السيارة التي تريد عرض بياناتها";
    document.getElementById("car1Status").textContent =
      english ? "Ready for API connection" : "جاهزة للاتصال بالـAPI";
    document.getElementById("car2Status").textContent =
      english ? "Ready for API connection" : "جاهزة للاتصال بالـAPI";
    document.getElementById("car1Button").textContent =
      english ? "View Data" : "عرض البيانات";
    document.getElementById("car2Button").textContent =
      english ? "View Data" : "عرض البيانات";
    document.getElementById("accountTitle").textContent =
      english ? "Account Data" : "بيانات الحساب";
    document.getElementById("logoutButton").textContent =
      english ? "Logout" : "تسجيل خروج";
  }
  window.addEventListener("load", () => {
    if (sessionStorage.getItem("site_access") === "1") {
      document.getElementById("accessBox").style.display = "none";
      document.getElementById("dashboard").style.display = "block";
    }
  });
</script>
</body>
</html>
