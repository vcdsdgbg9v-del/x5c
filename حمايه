<?php
declare(strict_types=1);
session_start();
/*
 * =========================
 * إعدادات الموقع
 * =========================
 */
// غيّر هذا إلى كود الدخول الخاص بك
$ACCESS_CODE = 'CHANGE_THIS_CODE';
// مدة الجلسة بالثواني: 24 ساعة
$SESSION_LIFETIME = 86400;
/*
 * =========================
 * تسجيل الخروج
 * =========================
 */
if (isset($_GET['logout'])) {
    $_SESSION = [];
    if (ini_get('session.use_cookies')) {
        $params = session_get_cookie_params();
        setcookie(
            session_name(),
            '',
            time() - 42000,
            $params['path'],
            $params['domain'],
            $params['secure'],
            $params['httponly']
        );
    }
    session_destroy();
    header('Location: index.php');
    exit;
}
/*
 * =========================
 * التحقق من الجلسة
 * =========================
 */
if (
    isset($_SESSION['authenticated'], $_SESSION['login_time']) &&
    $_SESSION['authenticated'] === true &&
    (time() - (int) $_SESSION['login_time']) < $SESSION_LIFETIME
) {
    $authenticated = true;
} else {
    $authenticated = false;
    unset($_SESSION['authenticated'], $_SESSION['login_time']);
}
/*
 * =========================
 * معالجة كود الدخول
 * =========================
 */
$error = '';
if (!$authenticated && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $enteredCode = isset($_POST['access_code'])
        ? trim((string) $_POST['access_code'])
        : '';
    if ($enteredCode !== '' && hash_equals($ACCESS_CODE, $enteredCode)) {
        session_regenerate_id(true);
        $_SESSION['authenticated'] = true;
        $_SESSION['login_time'] = time();
        header('Location: index.php');
        exit;
    } else {
        $error = 'كود الدخول غير صحيح.';
    }
}
/*
 * =========================
 * شاشة تسجيل الدخول
 * =========================
 */
if (!$authenticated):
?>
