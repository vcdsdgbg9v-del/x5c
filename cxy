import platform
import os
import subprocess


class DeviceInfo:
    def get_device_info(self):
        system = platform.system()
        release = platform.release()

        device_os = system
        device_name = platform.node() or "Unknown"
        build_number = release or "Unknown"

        try:
            if system == "Darwin":
                device_os = "macOS / Apple"
                device_name = (
                    subprocess.getoutput("sysctl -n hw.model") or "Mac"
                )
                build_number = (
                    subprocess.getoutput("sw_vers -productVersion")
                    or "Unknown"
                )

            elif system == "Linux":
                if os.path.exists("/system/bin"):
                    device_os = "Android"
                    device_name = (
                        subprocess.getoutput("getprop ro.product.model")
                        or "Android Device"
                    )
                    build_number = (
                        subprocess.getoutput(
                            "getprop ro.build.version.release"
                        )
                        or "Unknown"
                    )
                else:
                    device_os = "Linux"
                    device_name = "Linux Device"
                    build_number = release

            elif system == "Windows":
                device_os = "Windows"
                device_name = platform.node() or "Windows PC"
                build_number = release

        except Exception:
            pass

        return {
            "device_os": device_os,
            "device_name": device_name,
            "build_number": build_number,
        }


# مثال الاستخدام
device = DeviceInfo()
info = device.get_device_info()

print("نظام الجهاز:", info["device_os"])
print("اسم الجهاز:", info["device_name"])
print("إصدار النظام:", info["build_number"])
