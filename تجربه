import requests

FIREBASE_URL = "https://www.googleapis.com/identitytoolkit/v3/relyingparty/verifyPassword"
CPM_BASE = "https://us-central1-cp-multiplayer.cloudfunctions.net"

API_KEY = "PUT_YOUR_AUTHORIZED_FIREBASE_API_KEY_HERE"

email = input("CPM test email: ")
password = input("CPM test password: ")

# 1) Login
login_data = {
    "email": email,
    "password": password,
    "returnSecureToken": True
}

r = requests.post(
    FIREBASE_URL,
    params={"key": API_KEY},
    json=login_data,
    timeout=15
)

print("Login HTTP:", r.status_code)

if not r.ok:
    print("Login failed:")
    print(r.text)
    raise SystemExit

auth = r.json()
id_token = auth.get("idToken")

if not id_token:
    print("No idToken returned.")
    raise SystemExit

headers = {
    "Authorization": f"Bearer {id_token}",
    "Content-Type": "application/json"
}

# 2) Read account data
r = requests.post(
    f"{CPM_BASE}/GetPlayerRecords2/",
    headers=headers,
    json={"data": None},
    timeout=15
)

print("\nAccount HTTP:", r.status_code)
print(r.text)

# 3) Read cars
r = requests.post(
    f"{CPM_BASE}/TestGetAllCars/",
    headers=headers,
    json={"data": None},
    timeout=15
)

print("\nCars HTTP:", r.status_code)
print(r.text)
